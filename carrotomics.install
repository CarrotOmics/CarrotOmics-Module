<?php
/**
 * @file
 * Contains functions used to install/uninstall the CarrotOmics module.
 */

use Drupal\Core\Database\ConnectionNotDefinedException;
use Drupal\Core\Database\Database;
use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\user\Entity\Role;

/**
 * Implements hook_requirements().
 *
 * This hook does not support attributes and must remain procedural.
 */
function tripal_file_requirements($phase) {
  $requirements = [];
  if ($phase == 'install') {
    if (version_compare(\Drupal::VERSION, 10.6) < 0) {
      $requirements['carrotomics'] = [
        'title' => 'carrotomics',
        'value' => 'ERROR: You must have Drupal version 10.6 or higher installed to use this module.',
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  return $requirements;
}

/**
 * Implementation of hook_install().
 *
 * @ingroup carrotomics
 */
function carrotomics_install() {
  $chado = \Drupal::service('tripal_chado.database');

  // Create tripal terms for the new CV terms defined in YAML files.
  carrotomics_show_message('Adding new vocabulary terms');
  carrotomics_create_tripal_terms();

#  // Add custom tables
#  carrotomics_add_custom_tables();

  // Add the custom tables needed to associate Chado content with files.
  carrotomics_show_message('Adding module tables');
  \Drupal::service('carrotomics.rebuild_service')->createCustomChadoTables();

#  // Add columns to chado.nd_geolocation table
#  carrotomics_update_nd_geolocation();
#  // Add various required cv terms
#  carrotomics_add_cv_terms();
}

/**
 * Implements hook_uninstall().
 *
 * @ingroup tripal
 */
function tripal_uninstall() {
  // Remove configuration.
  $config = \Drupal::service('config.factory')
    ->getEditable('carrotomics.settings');
  $config->delete();
}

/**
 * Displays a status message.
 * 
 * This handles displaying both to the UI and to drush output.
 *
 * @param string $message
 *   The message to be displayed.
 */
function carrotomics_show_message(string $message) {
  // This is displayed when this module is installed with the UI.
  \Drupal::messenger()->addStatus($message);
  // This is displayed when this module is installed with drush.
  \Drupal::logger('carrotomics')->notice($message);
}

/**
 * Creates tripal terms for newly added CV terms for content types.
 *
 * The new CV terms are defined in YAML in /config/install/
 * carrotomics.tripal_content_terms.carrotomics_content_terms.yml
 * and files located there are added automatically by Drupal,
 * so here we just need to install them.
 *
 * @return void
 *   No return value.
 */
function carrotomics_create_tripal_terms(): void {
  $terms_init_service = \Drupal::service('tripal_chado.terms_init');
  $terms_init_service->installTerms('carrotomics_content_terms');
}

/**
 * Add custom tables:
 *   stock_analysis, project_featuremap
 */
function carrotomics_add_custom_tables() {
  carrotomics_add_table_stock_analysis();
  carrotomics_add_table_biomaterial_stock();
  carrotomics_add_table_biomaterial_analysis();
  carrotomics_add_table_project_featuremap();
  carrotomics_add_table_project_image();
  carrotomics_add_table_analysis_image();
  // CarrotOmics is more strict about stock uniquename.
  chado_query('ALTER TABLE chado.stock ADD CONSTRAINT stock_c2 UNIQUE (uniquename)');
}
