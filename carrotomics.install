<?php

/**
 * @file
 * Contains functions used to install/uninstall the CarrotOmics module.
 */

#use Drupal\Core\Database\ConnectionNotDefinedException;
#use Drupal\Core\Database\Database;
#use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
#use Drupal\user\Entity\Role;

/**
 * Implements hook_requirements().
 *
 * This hook does not support attributes and must remain procedural.
 */
function carrotomics_requirements($phase) {
  $requirements = [];
  if ($phase == 'install') {
    if (version_compare(\Drupal::VERSION, 11.3) < 0) {
      $requirements['carrotomics'] = [
        'title' => 'carrotomics',
        'value' => 'ERROR: You must have Drupal version 11.3 or higher installed to use this module.',
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  return $requirements;
}

/**
 * Implements hook_install().
 *
 * @ingroup carrotomics
 */
function carrotomics_install() {
  $chado_connection = \Drupal::service('tripal_chado.database');
  $schema = $chado_connection->schema();

  // For a migrated tripal 3 site, the following terms and tables
  // will already exist, so skip in this case.
  if (!$schema->tableExists('analysis_image')) {
    // Create tripal terms for the new CV terms defined in YAML files.
    carrotomics_show_message('Adding new vocabulary terms');
    carrotomics_create_tripal_terms();

    // Add some custom linker tables that CarrotOmics needs.
    // These are defined in the yaml file
    // config/other/carrotomics.custom_tables.yml.
    carrotomics_show_message('Adding module tables');
    \Drupal::service('carrotomics.rebuild_service')->createCustomChadoTables();

    // Add an additional constraint to stock. CarrotOmics does not like
    // to have uniquenames duplicated across different stock types.
    // i.e. ALTER TABLE chado.stock ADD CONSTRAINT stock_c2 UNIQUE (uniquename)
    // NOTE: creates "stock__c2__key" UNIQUE CONSTRAINT, btree (uniquename)
    // and for Tripal 3 the name was "stock_c2".
    $schema->addUniqueKey('stock', 'c2', ['uniquename']);
  }

  # // Add columns to chado.nd_geolocation table
  # carrotomics_update_nd_geolocation();

  // Associate terms with the linker tables.
  carrotomics_show_message('Adding linker table terms');
  carrotomics_add_linker_table_terms();

  // Import new content types defined in YAML for this module.
  carrotomics_show_message('Creating new content types: polypeptide, primer');
  carrotomics_import_content_types();

  // Import chado records required for CarrotOmics.
  // @todo chado.db insert GRINTaxon | The Germplasm Resources Information Network (GRIN) Taxonomy Database
  // | https://npgsweb.ars-grin.gov/gringlobal/taxonomydetail.aspx?id={accession}
  // | https://npgsweb.ars-grin.gov/gringlobal/taxon/abouttaxonomy.aspx |.
}

/**
 * Implements hook_uninstall().
 *
 * @ingroup tripal
 */
function carrotomics_uninstall() {
print "CPU1 install uninstall called\n";//;;;
  $chado_connection = \Drupal::service('tripal_chado.database');
  $schema = $chado_connection->schema();

  // Remove the new unique constraint added to stock.
  $schema->dropUniqueKey('stock', 'c2');

  // Delete the custom tables created by this module.
  \Drupal::service('carrotomics.hooks')->carrotomicsUninstall();

#  // Remove configuration.
#  $config = \Drupal::service('config.factory')
#    ->getEditable('carrotomics.settings');
#  $config->delete();
}

/**
 * Displays a status message.
 *
 * This handles displaying both to the UI and to drush output.
 *
 * @param string $message
 *   The message to be displayed.
 */
function carrotomics_show_message(string $message) {
  // This is displayed when this module is installed with the UI.
  \Drupal::messenger()->addStatus($message);
  // This is displayed when this module is installed with drush.
  \Drupal::logger('carrotomics')->notice($message);
}

/**
 * Creates tripal terms for newly added CV terms for content types.
 *
 * The new CV terms are defined in YAML in /config/install/
 * carrotomics.tripal_content_terms.carrotomics_content_terms.yml
 * and files located there are added automatically by Drupal,
 * so here we just need to install them.
 *
 * @return void
 *   No return value.
 */
function carrotomics_create_tripal_terms(): void {
  $terms_init_service = \Drupal::service('tripal_chado.terms_init');
  $terms_init_service->installTerms('carrotomics_content_terms');
}

/**
 * Adds the vocabulary terms for the linker table columns.
 *
 * @return void
 *   No return value.
 */
function carrotomics_add_linker_table_terms(): void {
  $storage_id = 'chado_term_mapping';
  $core_config_id = 'core_mapping';
  $carrotomics_config_id = 'carrotomics_mapping';
  /** @var Drupal\Core\Config\Entity\ConfigEntityStorage $storage */
  $storage = \Drupal::entityTypeManager()->getStorage($storage_id);
  /** @var Drupal\tripal_chado\Entity\ChadoTermMapping $chado_core_mapping */
  $chado_core_mapping = $storage->load($core_config_id);
  $core_mapping_tables = $chado_core_mapping->get('tables');

  // Get a keyed list to be able to determine if a table is already present.
  $existing_tables = [];
  foreach ($core_mapping_tables as $table) {
    $existing_tables[$table['name']] = TRUE;
  }

  // Get the table mapping for this module.
  $carrotomics_mapping = $storage->load($carrotomics_config_id);
  $carrotomics_tables = $carrotomics_mapping->get('tables');

  // Add table mappings from this module to core mapping.
  $updated = FALSE;
  foreach ($carrotomics_tables as $table) {
    if (!isset($existing_tables[$table['name']])) {
      $core_mapping_tables[] = $table;
      $updated = TRUE;
    }
  }
  if ($updated) {
    $chado_core_mapping->set('tables', $core_mapping_tables);
    $chado_core_mapping->save();
  }
}

/**
 * Creates content types and fields used by this module.
 *
 * The two new content types will be polypeptide and primer, which
 * are in the "carrotomics" collection defined by this module.
 *
 * @return void
 *   No return value.
 */
function carrotomics_import_content_types(): void {
  // Import the content type collection.
  $content_type_service = \Drupal::service('tripal.tripalentitytype_collection');
  $content_type_service->install(['carrotomics']);

  // Import the fields on the new content types.
  $fields_service = \Drupal::service('tripal.tripalfield_collection');
  $fields_service->install(['carrotomics']);
}
